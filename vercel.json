{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "rewrites": [
    { "source": "/", "destination": "/api/home-page" },
    { "source": "/index.html", "destination": "/api/home-page" },
    { "source": "/povernennya", "destination": "/povernennya.html" },
    { "source": "/povernennya/", "destination": "/povernennya.html" },
    { "source": "/dostavkaioplata", "destination": "/dostavkaioplata.html" },
    { "source": "/dostavkaioplata/", "destination": "/dostavkaioplata.html" },
    { "source": "/uhodakorystuvacha", "destination": "/uhodakorystuvacha.html" },
    { "source": "/uhodakorystuvacha/", "destination": "/uhodakorystuvacha.html" },
    { "source": "/politykakonfidenciynosti", "destination": "/politykakonfidenciynosti.html" },
    { "source": "/politykakonfidenciynosti/", "destination": "/politykakonfidenciynosti.html" },
    { "source": "/oferta", "destination": "/oferta.html" },
    { "source": "/oferta/", "destination": "/oferta.html" },
    { "source": "/product/:slug", "destination": "/api/product-page?slug=:slug" },
    { "source": "/product/:slug/", "destination": "/api/product-page?slug=:slug" },
    { "source": "/product/:slug*", "destination": "/api/product-page?slug=:slug*" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" }
  ]
}
